# Discord Bot Token (obtain from https://discord.com/developers/applications)
DISCORD_BOT_TOKEN=your_discord_bot_token_here

# DeBERTa-v3 Model (MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli or MoritzLaurer/DeBERTa-v3-xsmall-mnli-fever-anli)
MODEL_NAME=MoritzLaurer/DeBERTa-v3-base-mnli-fever-anli

# Evaluation Threshold (0.0 to 1.0; 0.70 means 70% certainty)
DEFAULT_THRESHOLD=0.70

# Web Dashboard Port & Host
WEB_HOST=127.0.0.1
WEB_PORT=8000
DASHBOARD_SECRET_KEY=change_to_a_random_secure_token
